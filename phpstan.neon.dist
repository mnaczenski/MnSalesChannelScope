parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - src/Resources
        # a standalone script run against a shop (php tests/acceptance/leak-check.php)
        - tests/acceptance
    bootstrapFiles:
        - tests/bootstrap.php
    treatPhpDocTypesAsCertain: false
    # Shopware Commercial is optional: its classes are unknown in CI, known in a shop.
    reportUnmatchedIgnoredErrors: false
