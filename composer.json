{
    "name": "mn/sales-channel-scope",
    "description": "Sales Channel Scope - limit admin roles to the data of their sales channels",
    "type": "shopware-platform-plugin",
    "version": "0.11.3",
    "license": "MIT",
    "authors": [
        {
            "name": "mn"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.14",
        "shopware/administration": "~6.7.14"
    },
    "extra": {
        "shopware-plugin-class": "Mn\\SalesChannelScope\\MnSalesChannelScope",
        "label": {
            "de-DE": "Verkaufskanal-Berechtigungen",
            "en-GB": "Sales Channel Scope"
        },
        "description": {
            "de-DE": "Beschränkt Admin-Rollen auf die Daten ihrer Verkaufskanäle: Bestellungen, Kunden, Produkte, Kategorien, Erlebniswelten, Promotions und Verkaufskanal-Einstellungen.",
            "en-GB": "Limits admin roles to the data of their sales channels: orders, customers, products, categories, Shopping Experiences, promotions and sales channel settings."
        }
    },
    "autoload": {
        "psr-4": {
            "Mn\\SalesChannelScope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mn\\SalesChannelScope\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:js": "node --experimental-detect-module --test tests/js/",
        "phpstan": "phpstan analyse --memory-limit=2G"
    }
}
