{% block sw_sales_channel_switch_select %}
<sw-entity-single-select
    id="salesChannelSelect"
    ref="salesChannelSelect"
    :disabled="disabled"
    :placeholder="$t('sw-sales-channel-switch.labelDefaultOption')"
    :label="label"
    :search-placeholder="$t('sw-sales-channel-switch.placeholderSelect')"
    :reset-option="mnRestricted ? undefined : $t('sw-sales-channel-switch.labelDefaultOption')"
    :value="salesChannelId"
    :criteria="salesChannelCriteria"
    entity="sales_channel"
    :show-clearable-button="!mnRestricted"
    @update:value="onChange"
>
    <template #labelProperty="{item, labelProperty}">
        <span v-if="item.translated">{{ item.translated[labelProperty] }}</span>
    </template>
</sw-entity-single-select>
{% endblock %}
