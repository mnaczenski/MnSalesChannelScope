{% block sw_category_smart_bar_save_category %}
    <mt-button
        v-if="category && mnCategoryReadOnly"
        v-tooltip.bottom="$t('mn-sales-channel-scope.category.readOnlyTooltip')"
        class="sw-category-detail__save-action mn-sales-channel-scope-read-only"
        variant="primary"
        disabled
    >
        {{ $t('global.default.save') }}
    </mt-button>
    <template v-else>
        {% parent %}
    </template>
{% endblock %}
