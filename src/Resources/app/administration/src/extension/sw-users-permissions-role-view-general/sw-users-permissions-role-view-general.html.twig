{% block sw_users_permissions_role_role_view_general_card_view_basic_information_description %}
    {% parent %}

    {% block mn_sales_channel_scope_role_sales_channels %}
        <sw-entity-multi-select
            v-if="mnSalesChannels"
            class="mn-sales-channel-scope-role-channels"
            :label="$t('mn-sales-channel-scope.role.label')"
            :help-text="$t('mn-sales-channel-scope.role.help')"
            :placeholder="$t('mn-sales-channel-scope.role.placeholder')"
            :entity-collection="mnSalesChannels"
            :disabled="isReadOnly"
            @update:entity-collection="onMnSalesChannelsChange"
        />
    {% endblock %}
{% endblock %}

{% block sw_users_permissions_role_role_view_general_card_view_permissions %}
    {% block mn_sales_channel_scope_role_presets %}
        <mt-card
            v-if="role && mnPresets.length > 0"
            class="mn-sales-channel-scope-presets"
            position-identifier="mn-sales-channel-scope-role-presets"
            :title="$t('mn-sales-channel-scope.preset.label')"
            :subtitle="$t('mn-sales-channel-scope.preset.subtitle')"
            :is-loading="isLoading"
        >
            <ul class="mn-sales-channel-scope-presets__list">
                <li
                    v-for="preset in mnPresets"
                    :key="preset.name"
                    class="mn-sales-channel-scope-presets__item"
                >
                    <div class="mn-sales-channel-scope-presets__text">
                        <span class="mn-sales-channel-scope-presets__name">
                            {{ mnPresetLabel(preset) }}
                        </span>
                        <span class="mn-sales-channel-scope-presets__description">
                            {{ mnPresetDescription(preset) }}
                        </span>
                    </div>

                    <mt-button
                        class="mn-sales-channel-scope-presets__button"
                        variant="secondary"
                        size="small"
                        :disabled="isReadOnly || mnPresetApplied(preset)"
                        @click="onMnApplyPreset(preset)"
                    >
                        <template v-if="mnPresetApplied(preset)">
                            <mt-icon
                                name="regular-checkmark-xs"
                                size="12px"
                            />
                            {{ $t('mn-sales-channel-scope.preset.added') }}
                        </template>
                        <template v-else>
                            {{ $t('mn-sales-channel-scope.preset.add') }}
                        </template>
                    </mt-button>
                </li>
            </ul>
        </mt-card>
    {% endblock %}

    {% parent %}
{% endblock %}
