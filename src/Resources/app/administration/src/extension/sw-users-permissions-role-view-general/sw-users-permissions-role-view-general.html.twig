{% block sw_users_permissions_role_role_view_general_card_view_basic_information_description %}
    {% parent %}

    {% block mn_sales_channel_scope_role_sales_channels %}
        <sw-entity-multi-select
            v-if="mnSalesChannels"
            class="mn-sales-channel-scope-role-channels"
            :label="$t('mn-sales-channel-scope.role.label')"
            :help-text="$t('mn-sales-channel-scope.role.help')"
            :placeholder="$t('mn-sales-channel-scope.role.placeholder')"
            :entity-collection="mnSalesChannels"
            :disabled="isReadOnly"
            @update:entity-collection="onMnSalesChannelsChange"
        />
    {% endblock %}

    {% block mn_sales_channel_scope_role_presets %}
        <div class="mn-sales-channel-scope-presets">
            <p class="mn-sales-channel-scope-presets__label">{{ $t('mn-sales-channel-scope.preset.label') }}</p>
            <mt-button
                v-for="preset in mnPresets"
                :key="preset.name"
                class="mn-sales-channel-scope-presets__button"
                variant="secondary"
                size="small"
                :disabled="isReadOnly"
                @click="onMnApplyPreset(preset)"
            >
                {{ $t('mn-sales-channel-scope.preset.apply', { name: $t(`mn-sales-channel-scope.preset.names.${preset.name}`) }) }}
            </mt-button>
            <p class="mn-sales-channel-scope-presets__help">{{ $t(`mn-sales-channel-scope.preset.help.${mnPresets[0].name}`) }}</p>
        </div>
    {% endblock %}
{% endblock %}
